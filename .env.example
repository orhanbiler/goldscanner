# ─── Anthropic (Claude vision scoring) ─────────────────────────────
# Required when AI scoring is enabled. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
# Model used to score item photos. Haiku 4.5 is the cheap, fast default.
GOLDSCANNER_MODEL=claude-haiku-4-5

# ─── What to look for ──────────────────────────────────────────────
# Comma-separated search phrases sent to shopgoodwill's search. Includes
# jewelry-lot phrases: the vision model hunts through lot photos for a
# matching bangle inside.
GOLDSCANNER_QUERIES=gold bangle,gold bracelet,gold filled bangle,gold filled bracelet,gold filled antique jewelry lot,gold filled victorian jewelry lot,gold lot,gold filled lot
# Listings whose title doesn't contain any of these are skipped without scoring.
GOLDSCANNER_TITLE_KEYWORDS=bangle,bracelet,lot,jewelry,jewellery,estate
# Photo budget: lots get more photos so the model can find a bangle inside.
GOLDSCANNER_MAX_IMAGES_LOT=6
# A plain-English description of the exact thing you want. This is fed to
# the vision model so it knows what counts as a match. (More detailed,
# editable guidance lives in the app's "Train the AI" tab.)
GOLDSCANNER_TARGET_DESCRIPTION=An antique / Victorian-era gold or gold-filled hinged bangle bracelet with ornate engraving, typically decorated with black taille d'épargne enamel in scrollwork or foliate patterns. Ornately hand-engraved antique gold bangles in this style also count even without enamel.
# Only act on items the model scores at or above this confidence (0.0–1.0).
GOLDSCANNER_MIN_CONFIDENCE=0.6
# Set to "false" to skip AI scoring and email every keyword match (cheaper, noisier).
GOLDSCANNER_USE_AI=true
# Max photos per item to send to the vision model.
GOLDSCANNER_MAX_IMAGES_PER_ITEM=3

# ─── Etsy source ───────────────────────────────────────────────────
GOLDSCANNER_ETSY_ENABLED=true
# RELIABLE: set an Etsy API key (free) to use the official API instead of
# scraping. Get one at https://www.etsy.com/developers (create an app).
ETSY_API_KEY=
# Keywords for Etsy API mode (comma-separated).
GOLDSCANNER_ETSY_QUERIES=antique victorian gold bangle,victorian enamel gold bangle
# Fallback (no key): scrape these search/market page URLs. Etsy's bot
# protection frequently blocks cloud IPs, so this often returns nothing.
GOLDSCANNER_ETSY_URLS=https://www.etsy.com/market/antique_victorian_gold_bangle,https://www.etsy.com/market/antique_victorian_gold_bangle?ref=pagination&page=2

# ─── eBay source (official Browse API) ─────────────────────────────
GOLDSCANNER_EBAY_ENABLED=true
# Free credentials at https://developer.ebay.com — create an app, then use the
# PRODUCTION App ID and Cert ID here. eBay's API is not bot-blocked.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
GOLDSCANNER_EBAY_QUERIES=antique victorian gold bangle enamel,victorian gold filled bangle
EBAY_MARKETPLACE=EBAY_US

# ─── Scan cadence ──────────────────────────────────────────────────
# Seconds between scans. 900 = every 15 minutes.
GOLDSCANNER_INTERVAL_SECONDS=900
# How many pages of results to scan per query (40 items per page).
GOLDSCANNER_PAGES_PER_QUERY=2
# Run a single scan and exit (useful for cron / testing). "true" or "false".
GOLDSCANNER_RUN_ONCE=false

# ─── Persistence ───────────────────────────────────────────────────
# Where to store the "already seen" database. On Railway, point this at a
# mounted volume (e.g. /data/goldscanner.db) so it survives redeploys.
GOLDSCANNER_DB_PATH=goldscanner.db

# ─── Email digest (SMTP) ───────────────────────────────────────────
# Gmail example: host smtp.gmail.com, port 587, user = your address,
# pass = a Google "App Password" (not your normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=you@gmail.com
EMAIL_TO=you@gmail.com
# Set to "false" to disable email and only log matches.
GOLDSCANNER_EMAIL_ENABLED=true
